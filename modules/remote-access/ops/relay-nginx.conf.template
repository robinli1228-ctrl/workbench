# 替换占位值后先运行 nginx -t；真实渲染结果留在私有配置中。
server {
    listen 80;
    server_name __PUBLIC_HOST__;
    access_log off;
    error_log /dev/null crit;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/workbench-access/acme; }
    location / { return 308 __PUBLIC_ORIGIN__$request_uri; }
}
server {
    listen __HTTPS_PORT__ ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/letsencrypt/live/__PUBLIC_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WorkbenchAccessTLS:1m;
    ssl_session_timeout 10m;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 0;
    location ~ ^/(worker(/|$)|api/(agent|worker)(/|$)) { return 403; }
    location / {
        proxy_pass http://127.0.0.1:__REMOTE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_redirect off;
    }
}
