# Copy to .env and fill in. Never commit the real file.
# Home node
HOST=127.0.0.1
PORT=4317
DATA_DIR=./.data
API_TOKEN=xxxxx
# Worker node
HOME_URL=ws://127.0.0.1:4317/worker
NODE_ID=xxxxx
NODE_NAME=xxxxx
WORKER_TOKEN=xxxxx
WORKER_DATA_DIR=./.local
WORKER_ROOTS=xxxxx
WORKER_CONCURRENCY=2
# Optional CLI binaries
# CODEX_BIN=codex
# Optional on Unix: point CODEX_BIN at the absolute path to bin/wb-codex-proxy,
# then set WORKBENCH_CODEX_PROXY to your HTTP proxy URL. Use WORKBENCH_CODEX_EXECUTABLE
# when the real codex executable is outside PATH.
# CLAUDE_BIN=claude
# GROK_BIN=grok
# AGY_BIN=agy
# CCUSAGE_BIN=ccusage
